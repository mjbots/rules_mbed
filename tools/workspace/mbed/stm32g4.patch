+  * @param  TIMx Timer instance
+  * @retval None
+  */
+__STATIC_INLINE void LL_TIM_DisableHSE32(TIM_TypeDef *TIMx)
+{
+  CLEAR_BIT(TIMx->OR, TIM_OR_HSE32EN);
+}
