+      /* Process Unlocked */
+      __HAL_UNLOCK(hhrtim);
+
+      break;
+    }
+  }
+
+  if (hhrtim->State == HAL_HRTIM_STATE_ERROR)
+  {
+    return HAL_ERROR;
+  }
+
+  /* Disable the timer counter */
+  __HAL_HRTIM_DISABLE(hhrtim, TimerIdxToTimerId[TimerIdx]);
