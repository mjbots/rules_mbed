+static DMA_HandleTypeDef *HRTIM_GetDMAHandleFromTimerIdx(const HRTIM_HandleTypeDef *hhrtim,
+                                                         uint32_t TimerIdx)
+{
+  DMA_HandleTypeDef *hdma = (DMA_HandleTypeDef *)NULL;
+
+  switch (TimerIdx)
