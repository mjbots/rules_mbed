+   ((COUNTER) == (uint32_t)0x00U))
+
+#define IS_HRTIM_TIMEEVENT_SOURCE(SOURCE)\
+  (((SOURCE) >= (uint32_t)0x00U) && ((SOURCE) <= (uint32_t)0x9U))
