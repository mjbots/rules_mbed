+    SET_BIT((__HANDLE__)->Instance->CR, RTC_CR_ADD1H);            \
+    MODIFY_REG((__HANDLE__)->Instance->CR, RTC_CR_BKP , (__BKP__)); \
+    __HAL_RTC_WRITEPROTECTION_ENABLE(__HANDLE__);                 \
+  } while(0);
