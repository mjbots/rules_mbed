+/* Define to prevent recursive inclusion -------------------------------------*/
+#ifndef STM32G4xx_HAL_I2C_EX_H
+#define STM32G4xx_HAL_I2C_EX_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Includes ------------------------------------------------------------------*/
+#include "stm32g4xx_hal_def.h"
+
+/** @addtogroup STM32G4xx_HAL_Driver
+  * @{
