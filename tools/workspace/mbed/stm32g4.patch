+  FMAC_HandleTypeDef *hfmac = (FMAC_HandleTypeDef *)((DMA_HandleTypeDef *)hdma)->Parent;
+
+  /* Set FMAC handle state to error */
+  hfmac->State = HAL_FMAC_STATE_ERROR;
