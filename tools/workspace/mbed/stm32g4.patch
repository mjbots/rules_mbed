+  uint32_t data_reg_addr;
+
+  if (Direction == LL_CORDIC_DMA_REG_DATA_OUT)
+  {
+    /* return address of RDATA register */
+    data_reg_addr = (uint32_t) &(CORDICx->RDATA);
+  }
