+      (__ADCx__)                                                               \
+    )                                                                          \
+  )
+#else
+#define __LL_ADC_MULTI_INSTANCE_MASTER(__ADCx__) \
+  ( ( ((__ADCx__) == ADC2)                                                     \
+    )?                                                                         \
+    (ADC1)                                                                     \
+    :                                                                          \
+    (__ADCx__)                                                                 \
+  )
+#endif /* ADC5 */
+#endif /* ADC_MULTIMODE_SUPPORT */
