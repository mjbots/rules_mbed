+  hfmac->ErrorCode |= HAL_FMAC_ERROR_DMA;
+
+  /* Call user callback */
+#if (USE_HAL_FMAC_REGISTER_CALLBACKS == 1)
+  hfmac->ErrorCallback(hfmac);
+#else
+  HAL_FMAC_ErrorCallback(hfmac);
+#endif /* USE_HAL_FMAC_REGISTER_CALLBACKS */
+}
