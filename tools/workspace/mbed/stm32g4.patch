+  *         @arg @ref LL_ADC_CHANNEL_VOPAMP2           (2)
+  *         @arg @ref LL_ADC_CHANNEL_VOPAMP3_ADC2      (2)
+  *         @arg @ref LL_ADC_CHANNEL_VOPAMP3_ADC3      (3)
+  *         @arg @ref LL_ADC_CHANNEL_VOPAMP4           (5)
